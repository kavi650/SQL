CREATE TABLE employee(
  emp_id NUMBER PRIMARY KEY,
  emp_name VARCHAR(20) NOT NULL,
  items VARCHAR(20),
  price NUMBER
);

INSERT INTO employee VALUES (121,'kavi','books',1899);
INSERT INTO employee VALUES (123,'raj','bike',289999);
INSERT INTO employee VALUES (124,'arun','phone',15000);
INSERT INTO employee VALUES (125,'siva','laptop',60000);

SELECT * FROM employee;

-- Subquery 1: Employee with maximum price
SELECT emp_name, price
FROM employee
WHERE price = (SELECT MAX(price) FROM employee);

-- Subquery 2: Employee with minimum price
SELECT emp_name, price
FROM employee
WHERE price = (SELECT MIN(price) FROM employee);

-- Subquery 5: Employee having same item as 'kavi'
SELECT emp_name, items
FROM employee
WHERE items = (SELECT items FROM employee WHERE emp_name='kavi');
